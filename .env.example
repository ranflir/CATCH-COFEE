# === Catch Coffee 환경변수 예시 ===
# 실제 값은 .env 에 작성 (커밋 금지)

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/catchcoffee

# --- App ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# --- Auth (시크릿은 최소 32자/256bit) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1800
JWT_REFRESH_EXPIRES_IN=1209600

# 결제수단 토큰 암호화 (AES-256-GCM, 최소 32자 권장)
ENCRYPTION_KEY=

# --- Redis (멱등성 키 캐시) ---
# 미설정 시 IdempotencyInterceptor 가 no-op 으로 통과
REDIS_URL=redis://localhost:6379

# --- 영수증 업로드 (S3 presigned) ---
# UploadsService 는 AWS SDK 기본 자격증명 체인 사용:
#   로컬: 아래 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#   배포: IAM Role / OIDC 권장 (키 직접 주입 불필요)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# 선택: CDN/커스텀 도메인. 미설정 시 https://{bucket}.s3.{region}.amazonaws.com
S3_PUBLIC_BASE_URL=

# --- 크롤러 / 푸시 (apps/crawler) ---
# 스케줄(node dist/main.js schedule). 미설정 시 매시 정각
CRON_SCHEDULE=0 * * * *
# Expo 푸시 액세스 토큰 (선택: 미설정 시 인증 헤더 없이 전송)
EXPO_ACCESS_TOKEN=

# --- 외부 연동 (예정/선택) ---
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
