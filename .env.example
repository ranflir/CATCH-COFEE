# === Catch Coffee 환경변수 예시 ===
# 실제 값은 .env 에 작성 (커밋 금지)

# DB / Cache
DATABASE_URL=postgresql://user:pass@localhost:5432/catchcoffee
REDIS_URL=redis://localhost:6379

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Auth (시크릿은 최소 32자/256bit)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1800
JWT_REFRESH_EXPIRES_IN=1209600

# 결제수단 토큰 암호화 (AES-256-GCM, 최소 32자 권장)
ENCRYPTION_KEY=

# 멱등성 키 캐시 (미설정 시 멱등성 인터셉터 no-op)
REDIS_URL=redis://localhost:6379

# 영수증 업로드 (S3 presigned)
AWS_REGION=ap-northeast-2
S3_BUCKET=
# 선택: CDN/커스텀 도메인. 미설정 시 https://{bucket}.s3.{region}.amazonaws.com
S3_PUBLIC_BASE_URL=

# Kakao (지도/장소 검색)
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=

# Push (FCM / Expo)
FCM_SERVICE_ACCOUNT=
EXPO_ACCESS_TOKEN=

# Storage (S3 호환: R2/S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payment (V1.1)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Optional
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
