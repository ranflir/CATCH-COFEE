# === Catch Coffee 환경변수 예시 ===
# 실제 값은 .env 에 작성 (커밋 금지)

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5433/catchcoffee

# --- App ---
NODE_ENV=development
PORT=3000
# CORS 허용 오리진. 콤마로 다중 지정 가능. 로컬(localhost:3000/3001)은 기본 허용.
# 예: https://app.catchcoffee.com,https://admin.catchcoffee.com
FRONTEND_URL=http://localhost:3001

# --- Auth (시크릿은 최소 32자/256bit) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1800
JWT_REFRESH_EXPIRES_IN=1209600

# 결제수단 토큰 암호화 (AES-256-GCM, 최소 32자 권장)
ENCRYPTION_KEY=

# --- Redis (멱등성 키 캐시) ---
# 미설정 시 IdempotencyInterceptor 가 no-op 으로 통과
REDIS_URL=redis://localhost:6379

# --- 영수증 업로드 (S3 presigned / R2 권장) ---
# UploadsService: AWS SDK S3Client
#   AWS S3: AWS_REGION + S3_BUCKET (+ IAM 키 또는 Role)
#   Cloudflare R2: 아래 S3_ENDPOINT + AWS_* + S3_PUBLIC_BASE_URL 필수
# 상세: docs/06-S3-R2-설정.md
AWS_REGION=ap-northeast-2
# R2 사용 시: auto 로 두고 S3_ENDPOINT 설정
# AWS_REGION=auto
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# R2 public bucket 또는 CloudFront/커스텀 도메인 (R2는 필수)
# 예: https://pub-xxxxxxxx.r2.dev
S3_PUBLIC_BASE_URL=

# --- 크롤러 / 푸시 (apps/crawler) ---
# 스케줄(node dist/main.js schedule). 미설정 시 매시 정각
CRON_SCHEDULE=0 * * * *
# Expo 푸시 액세스 토큰 (선택: 미설정 시 인증 헤더 없이 전송)
EXPO_ACCESS_TOKEN=

# --- 외부 연동 (예정/선택) ---
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
# 웹 지도 SDK (apps/web)
NEXT_PUBLIC_KAKAO_JS_KEY=
# 모바일 API (apps/mobile)
EXPO_PUBLIC_API_URL=http://localhost:3000
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
