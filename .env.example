# === Catch Coffee 환경변수 예시 ===
# 실제 값은 .env 에 작성 (커밋 금지)

# DB / Cache
DATABASE_URL=postgresql://user:pass@localhost:5432/catchcoffee
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Kakao (지도/장소 검색)
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=

# Push (FCM / Expo)
FCM_SERVICE_ACCOUNT=
EXPO_ACCESS_TOKEN=

# Storage (S3 호환: R2/S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payment (V1.1)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Optional
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
